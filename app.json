{
  "expo": {
    "name": "Lean30",
    "slug": "lean30",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lean30",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lean30.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.lean30.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0F0D",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#C6F135"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lean30 to access your photos so you can save progress pictures."
        }
      ]
    ]
  }
}